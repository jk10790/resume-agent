{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "resume-agent-api",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "api.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8001"
      ],
      "port": 8001
    },
    {
      "name": "resume-agent-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "frontend"
      ],
      "port": 3000,
      "env": {
        "VITE_API_TARGET": "http://localhost:8001"
      }
    }
  ]
}